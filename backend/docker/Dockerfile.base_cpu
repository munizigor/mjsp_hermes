FROM ubuntu:24.04

ENV PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=15

RUN apt update && apt install -y \
    python3 python3-pip \
    cmake build-essential make gcc sqlite3

RUN apt install -y \
    libboost-system-dev libboost-thread-dev \
    libboost-program-options-dev libboost-test-dev libboost-filesystem-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --break-system-packages pydantic numpy scipy soundfile \
    && (pip install --break-system-packages librosa || pip install --break-system-packages -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com librosa) \
    && pip install --break-system-packages --upgrade openai google-genai \
    && pip cache purge

