FROM hermes_base

RUN pip install --break-system-packages "fastapi[standard]" python-multipart
RUN pip cache purge
RUN pip freeze > /requirements2.txt
#RUN pip install -r /requirements.txt --break-system-packages

ENV FASTAPI_MODE=run
WORKDIR /src/hermes

COPY ./src/hermes /src/hermes
COPY ./src/init.sql /init.sql

#set open port 8000
EXPOSE 8001

CMD ["sh", "-c", "exec fastapi ${FASTAPI_MODE:-run} --host 0.0.0.0 --port 8001 /src/hermes/start.py"]