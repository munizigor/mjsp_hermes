FROM hermes_base

RUN pip install --break-system-packages "fastapi[standard]"
RUN pip install --break-system-packages scipy numpy python-multipart
RUN pip install --break-system-packages librosa
RUN pip install --break-system-packages soundfile
RUN pip cache purge
RUN pip freeze > /requirements2.txt
#RUN pip install -r /requirements.txt --break-system-packages

COPY ./src/hermes /src
COPY ./src/init.sql /init.sql

#set open port 8000
EXPOSE 8001

CMD ["fastapi", "dev", "--host", "0.0.0.0", "--port", "8001", "/src/start.py"]