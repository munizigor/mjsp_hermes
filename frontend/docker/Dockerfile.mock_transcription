FROM ubuntu:24.04

RUN apt update && apt install -y \
    python3 python3-pip \
    cmake build-essential make gcc libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY ./requirements_linux.txt /requirements.txt

RUN pip install --break-system-packages -r /requirements.txt

COPY ./hermes.proto /hermes.proto
COPY ./mock_servicer.py /mock_servicer.py
COPY ./mock_transcription_server.py /mock_transcription_server.py

RUN python3 -m grpc_tools.protoc -I. --python_out=. --pyi_out=. --grpc_python_out=. hermes.proto

EXPOSE 8002
EXPOSE 50051

CMD ["python3", "mock_transcription_server.py", "50051"]
